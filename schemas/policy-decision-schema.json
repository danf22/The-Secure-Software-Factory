{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "policy-decision-schema.json",
  "title": "Policy Decision Record",
  "description": "Schema for a policy gate decision record from a pipeline run.",
  "type": "object",
  "required": [
    "decision_id",
    "commit_sha",
    "timestamp",
    "passed",
    "violations",
    "waivers_applied",
    "scan_summary"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "description": "Unique identifier for this decision (UUID).",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "description": "Git commit SHA this decision applies to.",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 datetime when the decision was made.",
      "format": "date-time"
    },
    "passed": {
      "type": "boolean",
      "description": "Whether the policy gate passed."
    },
    "violations": {
      "type": "array",
      "description": "List of policy violations detected.",
      "items": {
        "type": "object",
        "required": ["policy_id", "message", "resource", "severity", "regulatory_refs"],
        "properties": {
          "policy_id": {
            "type": "string",
            "description": "Identifier of the violated policy.",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of the violation.",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "description": "Offending resource identifier.",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "description": "Severity level of the violation.",
            "enum": ["critical", "high", "medium", "low"]
          },
          "regulatory_refs": {
            "type": "array",
            "description": "Regulatory control references for this violation.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "waivers_applied": {
      "type": "array",
      "description": "List of waivers that were applied to allow violations.",
      "items": {
        "type": "object",
        "required": ["waiver_id", "policy_id", "approver", "expiration_date"],
        "properties": {
          "waiver_id": {
            "type": "string",
            "description": "Unique identifier of the applied waiver.",
            "minLength": 1
          },
          "policy_id": {
            "type": "string",
            "description": "Policy the waiver covers.",
            "minLength": 1
          },
          "approver": {
            "type": "string",
            "description": "Who approved the waiver.",
            "minLength": 1
          },
          "expiration_date": {
            "type": "string",
            "description": "When the waiver expires (ISO 8601 date).",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "scan_summary": {
      "type": "object",
      "description": "Summary of scan findings by scanner.",
      "required": ["total_findings", "by_scanner"],
      "properties": {
        "total_findings": {
          "type": "integer",
          "description": "Total number of findings across all scanners.",
          "minimum": 0
        },
        "by_scanner": {
          "type": "object",
          "description": "Finding counts per scanner.",
          "properties": {
            "gitleaks": { "type": "integer", "minimum": 0 },
            "semgrep": { "type": "integer", "minimum": 0 },
            "trivy_fs": { "type": "integer", "minimum": 0 },
            "checkov": { "type": "integer", "minimum": 0 },
            "trivy_image": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
